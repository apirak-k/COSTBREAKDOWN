        <mxCell id="edge_pdca_loop" value="&lt;b&gt;PDCA Loop: New Baseline Reset (Base = Active)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=3;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=#ECFDF5;fontColor=#065F46;fontSize=11;" edge="1" parent="1" source="node_promote_baseline" target="node_master_tables">
