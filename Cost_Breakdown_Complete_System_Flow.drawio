        <!-- 3-Scenario What-If Simulator -->
        <mxCell id="node_whatif_grid" value="&lt;b style='color:#0F172A;'&gt;2. What-If 2-Step Multi-Factor Simulator&lt;/b&gt;&lt;br&gt;Simulate 3 Scenarios: &lt;b&gt;Option A, Option B, Option C&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#0369A1;'&gt;Step 1 (Gross Saving):&lt;/b&gt;&lt;br&gt;• Primary Target: Yield % / Cap / Price / Loss&lt;br&gt;• Secondary Target: Manning (Heads)&lt;br&gt;&lt;br&gt;&lt;b style='color:#0369A1;'&gt;Step 2 (Unit Added Cost Allocation):&lt;/b&gt;&lt;br&gt;• Fixed Inv / Unit = Lump-sum Investment ÷ Lot Size&lt;br&gt;• Var Cost / Unit = Direct Variable Add-on (THB/pc)&lt;br&gt;&lt;br&gt;&lt;b&gt;Net Saving = Gross Saving - Total Added Cost&lt;/b&gt;&lt;br&gt;&lt;b&gt;Predicted Std Cost = Active Cost - Net Saving&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1275" y="280" width="360" height="235" as="geometry" />
